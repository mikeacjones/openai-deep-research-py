# Temporal local defaults. The demo-cloud registry injects its own values.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=deep-research

# Temporal Cloud API-key authentication (TLS is enabled automatically).
# TEMPORAL_API_KEY=

# Optional alternatives to API-key authentication.
# TEMPORAL_TLS=true
# TEMPORAL_TLS_CERT=/path/to/client.pem
# TEMPORAL_TLS_KEY=/path/to/client.key

# Required for live OpenAI calls.
OPENAI_API_KEY=
